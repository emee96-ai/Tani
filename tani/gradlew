#!/bin/sh
set -eu
if [ -z "${JAVA_HOME:-}" ]; then command -v java >/dev/null 2>&1 || { echo 'Java 17+ is required.' >&2; exit 1; }; JAVA_HOME="$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")"; export JAVA_HOME; fi
if [ ! -f gradle/wrapper/gradle-wrapper.jar ]; then echo 'Gradle wrapper JAR is not bundled; import in Android Studio and sync with Gradle 8.7.' >&2; exit 1; fi
exec "$JAVA_HOME/bin/java" -classpath gradle/wrapper/gradle-wrapper.jar org.gradle.wrapper.GradleWrapperMain "$@"
