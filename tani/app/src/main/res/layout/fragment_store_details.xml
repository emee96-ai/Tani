<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tani_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
        <TextView
            android:id="@+id/store_details_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="جاري تحميل المتجر..."
            android:textColor="@color/text_muted" />
        <LinearLayout
            android:id="@+id/store_details_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/store_details_cover"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@color/border"
                android:contentDescription="غلاف المتجر"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery" />
            <ImageView
                android:id="@+id/store_details_logo"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_avatar"
                android:contentDescription="شعار المتجر"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery" />
            <TextView
                android:id="@+id/store_details_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_dark"
                android:textSize="25sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/store_details_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_muted" />
            <TextView
                android:id="@+id/store_details_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_muted" />
            <TextView
                android:id="@+id/store_details_rating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_muted" />
            <TextView
                android:id="@+id/store_details_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_dark" />
            <TextView
                android:id="@+id/store_details_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_muted" />
            <TextView
                android:id="@+id/store_details_delivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:textColor="@color/text_muted" />
            <Button
                android:id="@+id/store_details_share"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="مشاركة المتجر" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="منتجات المتجر"
                android:textColor="@color/text_dark"
                android:textSize="20sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/store_details_products"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
