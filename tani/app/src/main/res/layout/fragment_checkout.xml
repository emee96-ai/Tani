<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tani_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إتمام الطلب"
            android:textColor="@color/text_dark"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="العنوان ← منطقة التوصيل ← المراجعة ← التأكيد"
            android:textColor="@color/tani_primary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="اختاري منطقة التوصيل لكل متجر حتى نحسب الرسوم الصحيحة"
            android:textColor="@color/text_muted" />

        <ProgressBar
            android:id="@+id/checkout_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1  عنوان التوصيل" android:textColor="@color/text_dark" android:textSize="18sp" android:textStyle="bold" />
            <RadioGroup android:id="@+id/checkout_addresses" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            <Button android:id="@+id/checkout_add_address" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:text="إضافة عنوان جديد" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/checkout_delivery_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2  منطقة التوصيل"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/checkout_delivery_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="اختاري المنطقة المناسبة تحت كل متجر"
                android:textColor="@color/text_muted" />

            <LinearLayout
                android:id="@+id/checkout_delivery_zones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="3  بيانات الاستلام" android:textColor="@color/text_dark" android:textSize="18sp" android:textStyle="bold" />
            <EditText android:id="@+id/checkout_phone" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_field" android:hint="رقم الهاتف" android:inputType="phone" android:paddingHorizontal="14dp" android:singleLine="true" />
            <EditText android:id="@+id/checkout_notes" android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="10dp" android:background="@drawable/bg_field" android:gravity="top|start" android:hint="ملاحظات للتاجر أو المندوب" android:padding="14dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="4  مراجعة الطلب" android:textColor="@color/text_dark" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="الدفع عند الاستلام (COD)" android:textColor="@color/text_muted" />
            <LinearLayout android:id="@+id/checkout_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />
            <TextView android:id="@+id/checkout_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/tani_primary" android:textSize="21sp" android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/checkout_confirm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="26dp"
            android:text="تأكيد وإرسال الطلب" />
    </LinearLayout>
</ScrollView>
