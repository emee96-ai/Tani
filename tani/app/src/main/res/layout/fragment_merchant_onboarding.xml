<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tani_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:background="@color/tani_surface">

        <TextView
            android:id="@+id/merchant_onboarding_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ابدئي البيع على تاني"
            android:textColor="@color/text_dark"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="start" />

        <TextView
            android:id="@+id/merchant_onboarding_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="الخطوة 1 من 4"
            android:textColor="@color/tani_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/merchant_onboarding_progress"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="4"
            android:progress="1"
            app:indicatorColor="@color/tani_primary"
            app:trackColor="@color/brand_soft"
            app:trackCornerRadius="3dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/merchant_onboarding_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp" />
    </ScrollView>

    <TextView
        android:id="@+id/merchant_onboarding_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tani_surface"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="2dp"
        android:text="جاري الإرسال…"
        android:textColor="@color/tani_primary"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:background="@color/tani_surface">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/merchant_onboarding_back"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="السابق"
            android:textAllCaps="false"
            android:textColor="@color/tani_primary"
            app:strokeColor="@color/tani_primary" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ProgressBar
            android:id="@+id/merchant_onboarding_submit_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:indeterminateTint="@color/tani_primary"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/merchant_onboarding_next"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:minWidth="148dp"
            android:text="التالي"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/tani_primary"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>
