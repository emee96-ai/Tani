<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tani_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="92dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView android:id="@+id/product_details_loading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="جاري تحميل المنتج..." android:textColor="@color/text_muted" />
            <LinearLayout android:id="@+id/product_details_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <ImageView android:id="@+id/product_details_image" android:layout_width="match_parent" android:layout_height="240dp" android:background="@color/brand_soft" android:contentDescription="صورة المنتج" android:scaleType="centerCrop" android:src="@drawable/ic_image_placeholder" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none"><LinearLayout android:id="@+id/product_details_images" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" /></HorizontalScrollView>
                <TextView android:id="@+id/product_details_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/text_dark" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:id="@+id/product_details_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/tani_primary" android:textSize="21sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/product_details_stock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/success" android:textStyle="bold" />
                    <TextView android:id="@+id/product_details_rating" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:textColor="@color/text_muted" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="14dp">
                    <TextView android:id="@+id/product_details_merchant" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_dark" android:textStyle="bold" />
                    <TextView android:id="@+id/product_details_trust" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_muted" />
                    <TextView android:id="@+id/product_details_delivery" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_muted" />
                </LinearLayout>
                <TextView android:id="@+id/product_details_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:lineSpacingExtra="4dp" android:textColor="@color/text_dark" android:textSize="15sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <Button android:id="@+id/product_details_store" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="المتجر" />
                    <Button android:id="@+id/product_details_favorite" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="حفظ" />
                    <Button android:id="@+id/product_details_share" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="مشاركة" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="خيارات متاحة من المتجر" android:textColor="@color/text_dark" android:textSize="19sp" android:textStyle="bold" />
                <TextView android:id="@+id/product_details_variant_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="تُعرض الخيارات المتاحة هنا، ويؤكد المتجر تفاصيل الخيار مع الطلب." android:textColor="@color/text_muted" android:textSize="13sp" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none"><LinearLayout android:id="@+id/product_details_variants" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" /></HorizontalScrollView>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="التقييمات" android:textColor="@color/text_dark" android:textSize="19sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/product_details_reviews" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="منتجات مشابهة" android:textColor="@color/text_dark" android:textSize="19sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/product_details_related" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="@color/tani_surface" android:elevation="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <TextView android:id="@+id/product_details_sticky_price" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/tani_primary" android:textSize="19sp" android:textStyle="bold" />
        <Button android:id="@+id/product_details_add" android:layout_width="160dp" android:layout_height="54dp" android:enabled="false" android:text="جاري التحميل" />
    </LinearLayout>
</FrameLayout>
