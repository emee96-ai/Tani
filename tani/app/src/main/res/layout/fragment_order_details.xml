<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tani_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
        <TextView
            android:id="@+id/order_details_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تفاصيل الطلب"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark" />
        <ProgressBar
            android:id="@+id/order_details_progress"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp" />
        <LinearLayout
            android:id="@+id/order_details_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="طلبات المتاجر"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark" />
        <LinearLayout
            android:id="@+id/order_details_merchants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp" />
        <Button
            android:id="@+id/order_details_cancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="إلغاء الطلب"
            android:visibility="gone" />
        <Button
            android:id="@+id/order_details_refresh"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="26dp"
            android:text="تحديث الحالة" />
    </LinearLayout>
</ScrollView>
