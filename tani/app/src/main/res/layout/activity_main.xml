<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tani_background"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tani_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/tani_background"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/top_app_bar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@color/tani_surface"
                android:elevation="0dp"
                android:layoutDirection="rtl"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone"
                app:navigationIcon="@drawable/ic_menu"
                app:navigationIconTint="@color/text_dark"
                app:titleCentered="true"
                app:titleTextColor="@color/text_dark" />

            <FrameLayout
                android:id="@+id/nav_host"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bottom_nav"
                android:elevation="8dp"
                android:minHeight="70dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                app:itemIconTint="@color/nav_colors"
                app:itemTextColor="@color/nav_colors"
                app:labelVisibilityMode="labeled" />
        </LinearLayout>

        <ImageView
            android:id="@+id/launch_splash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/tani_splash_screen" />
    </FrameLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/drawer_nav"
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layoutDirection="rtl"
        android:background="@color/tani_surface"
        app:headerLayout="@layout/drawer_header"
        app:itemHorizontalPadding="22dp"
        app:itemIconPadding="18dp"
        app:itemIconTint="@color/nav_colors"
        app:itemTextColor="@color/nav_colors"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
